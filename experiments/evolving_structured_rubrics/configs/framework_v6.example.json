{
  "protocol": "framework-v6-hierarchical-v1",
  "data_root": ".",
  "env_file": ".env",
  "max_epochs": 5,
  "datasets": {
    "discovery": "data/discovery_v2_demo_v3/discovery_100.jsonl",
    "dev": "data/discovery_v2_demo_v3/dev_150.jsonl",
    "vlrb": "data/VL_RewardBench/data/test-00000-of-00001.parquet"
  },
  "worker": {
    "model": "Qwen/Qwen3-VL-8B-Instruct",
    "api_retry_attempts": 0,
    "temperature": 0.5,
    "max_tokens": 2048,
    "backend_pool": {
      "pool_id": "framework-v6-worker",
      "common_checkpoint_id": "Qwen3-VL-8B-Instruct",
      "global_request_concurrency": 50,
      "endpoints": [{
        "endpoint_id": "qwen3vl8b-local",
        "base_url": "http://localhost:8000/v1",
        "checkpoint_root": "Qwen3-VL-8B-Instruct",
        "max_concurrency": 50
      }]
    }
  },
  "manager": {
    "model": "Qwen/Qwen3.5-122B-A10B",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "GUIJI_API_KEY",
    "concurrency": 4,
    "timeout": 300,
    "request_kwargs": {
      "temperature": 0.2,
      "extra_body": {"enable_thinking": true}
    }
  }
}
