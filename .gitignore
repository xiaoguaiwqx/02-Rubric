# Python build products and local scratch/archive files
__pycache__
.local
*.egg-info/
build/

# Runtime artifacts are local by default, including new experiments.
# Already tracked historical reports remain tracked and are not deleted.
# Publish reviewed, compact evidence under docs/experiment-results/ instead
# of extending per-experiment allowlists for predictions and local manifests.
/output/

